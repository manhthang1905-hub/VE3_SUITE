# ============================================================
#  VE3_SUITE .gitignore
#  Loại trừ credentials, data, browser, cache
# ============================================================

# === PROJECT DATA (mỗi máy riêng) ===
PROJECTS/

# === CREDENTIALS & CONFIG NHẠy CẢM ===
config/suite_settings.json
config/creds.json
config/config.json
config/flow_project_auth_cache.json
tools/ve3/config/flow_accounts.yaml

# === CHROME BROWSER INSTANCES (mỗi máy riêng) ===
GoogleChromePortable*/
chrome_profiles/

# === REFERENCE IMAGES (anh nv1.png nang -> moi may copy rieng; nhung GIU style.yaml
#     tren git de cac may dong bo style/audience theo kenh) ===
tools/srt-to-excel/reference_characters/*
!tools/srt-to-excel/reference_characters/*/
tools/srt-to-excel/reference_characters/*/*
!tools/srt-to-excel/reference_characters/*/*/
tools/srt-to-excel/reference_characters/*/*/*
!tools/srt-to-excel/reference_characters/*/*/style.yaml

# === INSTALLER EXE (không cần track) ===
*.paf.exe

# === PYTHON CACHE ===
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# === LOGS & TEMP ===
*.log
*.tmp
*.lock
*.stale_*

# === RUNTIME METADATA (mỗi project riêng) ===
.excel_runtime_config.yaml
.nguon_runtime_metadata.yaml
.ve3_run_config.json
.progress_totals.json
.fingerprint_seed_*
.flow_auth_state.json

# === OS FILES ===
Thumbs.db
desktop.ini
.DS_Store

# === IDE ===
.vscode/
.idea/

# === CLAUDE CONFIG (mỗi máy riêng) ===
.claude/

# === SERVER CREDENTIALS & RUNTIME (mỗi VM riêng) ===
server/config/creds.json
server/config/config.json
server/config/accounts.csv
server/config/.project_accounts*.json
server/config/.account_index.json
server/config/.403_tracker.json
server/config/session_state.yaml
server/config/server_gui.json
server/config/proxies.txt
server/config/current_branch.txt
server/.agent/
server/logs/
server/PROJECTS/
server/GoogleChromePortable*/
server/chrome_profile*/

# === FLOWKIT SERVER (mỗi VM riêng) ===
server/flowkit/config/flowkit_gui.json
server/flowkit/GoogleChromePortable*/
server/flowkit/logs/
server/flowkit/update_temp*
server/flowkit/_ext_golden/
server/flowkit/.fingerprint_seed_*

old/
server/flowkit/_workflow_videos/

server/flowkit_backup_*/

# === VEO3TOP ENGINE: code commit, runtime/credentials BO QUA ===
veo3top_engine/_auth_cache/
veo3top_engine/out/
veo3top_engine/__pycache__/
veo3top_engine/.veo3top_warm_profiles/
veo3top_engine/.veo3top_blank_profiles/
veo3top_engine/.ipv6_override_*
.veo3top_pids/
.veo3top_rate/
.veo3top_pool.pid
.veo3top_imgpool.pid
.veo3top_pool_start.lock
.veo3top_imgpool_start.lock
.ipv6_override_*
server/flowkit/.proxy_health_*
**/__pycache__/
*.pyc
